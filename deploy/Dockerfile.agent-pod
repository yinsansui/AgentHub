FROM node:22-slim AS runtime-host
WORKDIR /opt/agenthub/ts-runtime-host
COPY runtimes/ts-runtime-host/package*.json ./
RUN npm ci
COPY runtimes/ts-runtime-host/tsconfig.json ./
COPY runtimes/ts-runtime-host/src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY .agenthub/bin/agent-pod /agent-pod
COPY --from=runtime-host /opt/agenthub/ts-runtime-host /opt/agenthub/ts-runtime-host
ENV AGENT_POD_ADDR=:3001 \
    WORKSPACE_DIR=/workspace \
    AGENTHUB_RUNTIME_COMMAND="node /opt/agenthub/ts-runtime-host/dist/main.js --adapter pi-coding-agent"
EXPOSE 3001
ENTRYPOINT ["/agent-pod"]
