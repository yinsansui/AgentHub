# AgentHub local development defaults.
# Copy this file to .env, adjust only what you need, then run:
#   make dev

# Local service ports.
AGENTHUB_CONTROL_PLANE_PORT=3000
AGENTHUB_AGENT_POD_PORT=3001
AGENTHUB_USER_PORTAL_PORT=5174

# Local PostgreSQL. Leave AGENTHUB_DATABASE_URL empty to let scripts/start-dev.sh
# start a Docker PostgreSQL container with agenthub/agenthub credentials.
AGENTHUB_POSTGRES_PORT=5432
AGENTHUB_POSTGRES_CONTAINER=agenthub-dev-postgres
AGENTHUB_POSTGRES_VOLUME=agenthub-dev-postgres-data
# AGENTHUB_DATABASE_URL=postgres://agenthub:agenthub@127.0.0.1:5432/agenthub?sslmode=disable

# Keep the PostgreSQL container running after the dev stack stops.
AGENTHUB_KEEP_POSTGRES=0

# Skip rebuilding the TypeScript runtime host on startup after it has already
# been built once. Go binaries are still rebuilt by the startup script.
AGENTHUB_SKIP_BUILD=0

# Internal local token used between control-plane and AgentPod.
# This is a local prototype default, not a production secret.
AGENTHUB_INTERNAL_TOKEN=dev-token

# AgentPod runtime command. The default below is computed by scripts/start-dev.sh
# with an absolute repo path, so most users should leave this unset.
# AGENTHUB_RUNTIME_COMMAND="node /absolute/path/to/AgentHub/runtimes/ts-runtime-host/dist/main.js --adapter pi-coding-agent"

# Real runtime smoke test settings. Fill these only when running
# `make smoke-real-runtime` against a local Anthropic-compatible endpoint.
# AGENTHUB_SMOKE_LLM_BASE_URL=http://example.local:8084
# AGENTHUB_SMOKE_LLM_API_KEY=replace-with-local-test-key
# AGENTHUB_SMOKE_LLM_MODEL_ID=k2p5
